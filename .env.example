# Copy this file to `.env` and adjust it if you need to
#    cp .env.example .env

# --- API --------------------------------------------------------------------
# Validated on boot by apps/api/src/config/env.ts. If either of these is wrong
# the API refuses to start and tells you which one.
NODE_ENV=development
PORT=3000

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
# LOG_PRETTY: leave unset to get colored lines in development and JSON in
# production.
LOG_LEVEL=debug

# --- Host ports ---
POSTGRES_PORT=5433
MONGO_PORT=27018
REDIS_PORT=6380
OLLAMA_PORT=11434

# --- PostgreSQL ---
POSTGRES_USER=firstrow
POSTGRES_PASSWORD=firstrow_dev_password
POSTGRES_DB=firstrow

# --- MongoDB ---
MONGO_USER=firstrow
MONGO_PASSWORD=firstrow_dev_password
MONGO_DB=firstrow